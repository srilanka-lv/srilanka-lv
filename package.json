{
  "name": "srilanka-lv",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "web:dev": "bun --elide-lines=0 --filter @srilanka/web dev",
    "web:build": "bun --elide-lines=0 --filter @srilanka/web build",
    "web:start": "bun --elide-lines=0 --filter @srilanka/web start",
    "web:storybook": "bun --elide-lines=0 --filter @srilanka/web sb",
    "web:build-storybook": "bun --elide-lines=0 --filter @srilanka/web build-sb",
    "studio:dev": "bun --elide-lines=0 --filter @srilanka/studio dev",
    "studio:build": "bun --elide-lines=0 --filter @srilanka/studio build",
    "studio:deploy": "bun --elide-lines=0 --filter @srilanka/studio deploy",
    "studio:typegen": "bun --elide-lines=0 --filter @srilanka/studio typegen",
    "repo:lint": "biome check",
    "repo:format": "biome format --write",
    "infra:kamal": "kamal -c infra/kamal/deploy.yml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@sanity/vision": "^6.0.0",
    "next-sanity": "^13.1.0",
    "sanity": "^6.0.0"
  }
}
