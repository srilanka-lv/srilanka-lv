{
  "name": "srilanka-lv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "bun --filter @srilanka/web dev",
    "web:build": "bun --filter @srilanka/web build",
    "web:storybook": "bun --filter @srilanka/web storybook",
    "studio:dev": "bun --filter @srilanka/studio dev",
    "studio:build": "bun --filter @srilanka/studio build",
    "studio:deploy": "bun --filter @srilanka/studio deploy",
    "studio:typegen": "bun --filter @srilanka/studio typegen",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^6.0.3"
  }
}
