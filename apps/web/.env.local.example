# Application
NEXT_PUBLIC_SELF_URL=

# IndexNow (key must match the public/{key}.txt file served at the site root)
INDEXNOW_KEY=

# Sanity
NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=
NEXT_PUBLIC_SANITY_STUDIO_DATASET=
SANITY_API_KEY=

# SERP API
SERPAPI_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Ask Grieta drawer leads. Leads are saved as contacts in this Resend segment
# (Audience → Segments; never the newsletter one). Unset skips that step; the
# lead email still goes out.
RESEND_LEADS_SEGMENT_ID=
# Where lead emails go. Defaults to sveiki@srilanka.lv.
LEAD_NOTIFICATION_EMAIL=
# Email transport: resend (default) or mailpit. mailpit sends every email to
# the local Mailpit inbox (bun mailpit:start, then http://localhost:8025) and
# skips the Resend audience. It is refused when NODE_ENV=production.
EMAIL_TRANSPORT=
