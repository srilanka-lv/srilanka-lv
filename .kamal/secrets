# Kamal reads this file to populate the env vars referenced as secrets in
# infra/kamal/deploy.yml — i.e. anything under `env.secret:` (the app secrets),
# the `registry.password` reference (KAMAL_REGISTRY_PASSWORD), and the
# `proxy.ssl.{certificate,private_key}_pem` references (the Cloudflare Origin
# Cert + key).
#
# Non-secret config (NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID, RESEND_AUDIENCE_ID,
# the per-env NEXT_PUBLIC_SELF_URL / NEXT_PUBLIC_SANITY_STUDIO_DATASET /
# SENTRY_ENVIRONMENT) is NOT in this file — those resolve via ENV.fetch in
# the YAMLs and come from GitHub Variables (vars.*) in CI or sourced
# .kamal/.env.<destination> files locally.
#
# In CI, GitHub Actions exposes secrets via the deploy step's `env:` block.
# Locally, source the matching .kamal/.env.<destination> file first.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SANITY_API_KEY=$SANITY_API_KEY
RESEND_API_KEY=$RESEND_API_KEY
SERPAPI_API_KEY=$SERPAPI_API_KEY
KAMAL_PROXY_TLS_CERT=$KAMAL_PROXY_TLS_CERT
KAMAL_PROXY_TLS_KEY=$KAMAL_PROXY_TLS_KEY
