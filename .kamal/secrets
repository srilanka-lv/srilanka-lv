# Kamal reads this file to populate the env vars listed under `env.secret:` in
# config/deploy.yml. Each line is a shell assignment.
#
# In CI, GitHub Actions exposes secrets to the deploy step via the `env:` block,
# so the `$VAR` references below resolve from the surrounding shell. The values
# come from the GitHub Environment matching the destination being deployed.
#
# To run Kamal locally, set these env vars in your shell first (e.g. via
# direnv, 1Password CLI, or a sourced .env file kept outside the repo).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SANITY_API_KEY=$SANITY_API_KEY
RESEND_API_KEY=$RESEND_API_KEY
RESEND_AUDIENCE_ID=$RESEND_AUDIENCE_ID
SERPAPI_API_KEY=$SERPAPI_API_KEY
NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=$NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID
KAMAL_PROXY_TLS_CERT=$KAMAL_PROXY_TLS_CERT
KAMAL_PROXY_TLS_KEY=$KAMAL_PROXY_TLS_KEY
